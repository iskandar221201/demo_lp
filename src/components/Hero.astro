---
import { distributor, waLink } from "../data/distributor.js";

const consultHref = waLink(
  "Halo Kak Rina, aku mau konsultasi gratis soal skincare Glowvit."
);
---

<section class="bg-cream-50">
  <div
    class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 md:items-center md:py-20 lg:px-8"
  >
    <div>
      <p class="text-sm font-bold text-terra-600">
        Skincare vitamin C dari {distributor.company}
      </p>
      <h1 class="mt-3 text-4xl font-extrabold leading-tight tracking-tight text-coco-950 sm:text-5xl">
        {distributor.tagline}
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-coco-600">
        Aku Rina, distributor resmi Glowvit. Aku bantu kamu memilih skincare yang cocok
        untuk jenis kulitmu, mulai dari konsultasi gratis sampai pendampingan pemakaian.
        Tidak ada paksaan beli, santai saja.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a
          href={consultHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full bg-wa-600 px-6 py-3 text-base font-bold text-white transition-colors hover:bg-wa-700"
        >
          Konsultasi Gratis via WhatsApp
        </a>
        <a
          href="#produk"
          class="inline-flex min-h-[44px] items-center justify-center rounded-full border-2 border-terra-300 px-6 py-3 text-base font-bold text-terra-700 transition-colors hover:border-terra-500 hover:bg-terra-50"
        >
          Lihat Produknya
        </a>
      </div>
      <p class="mt-4 text-sm text-coco-500">
        Dibales cepat di jam kerja. Kalau belum cocok, tidak apa-apa.
      </p>
    </div>

    <figure class="mx-auto w-full max-w-md">
      <img
        src="https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=1200&q=80"
        alt="Rangkaian produk skincare Glowvit di atas meja (foto ilustrasi dari Unsplash)"
        width="1200"
        height="800"
        loading="eager"
        class="aspect-[4/3] w-full rounded-2xl object-cover"
      />
      <figcaption class="mt-3 text-center text-sm text-coco-500">
        Foto ilustrasi produk (Unsplash), bukan foto kemasan asli Glowvit
      </figcaption>
    </figure>
  </div>
</section>
